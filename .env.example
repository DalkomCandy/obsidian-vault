# Google Cloud Console에서 발급받은 API 키를 넣어주세요.
# 활성화해야 하는 API: Maps JavaScript API, Places API
VITE_GOOGLE_MAPS_API_KEY=

# (선택) Cloud Console > Map Management 에서 만든 Map ID.
# 비워두면 Google이 제공하는 테스트용 "DEMO_MAP_ID"를 사용합니다.
VITE_GOOGLE_MAPS_MAP_ID=

# (선택) Supabase를 사용한 기기 간 동기화. 비워두면 이 기기의 localStorage만 사용합니다.
# supabase.com 에서 프로젝트를 만들고 Project Settings > API 에서 값을 복사하세요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
